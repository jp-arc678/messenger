<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Messenger.UnitTests</RootNamespace>
    <AssemblyName>Messenger.UnitTests</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- ไฟล์ซอร์สมีข้อความภาษาไทย บังคับให้ compiler อ่านเป็น UTF-8 -->
    <CodePage>65001</CodePage>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Domain\Messenger.Domain.csproj" />
    <ProjectReference Include="..\..\src\Application\Messenger.Application.csproj" />
  </ItemGroup>

</Project>
