[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.dll
*.pdb
*.exe

# NuGet
packages/
*.nupkg
!packages/build/

# Visual Studio / user-specific
.vs/
*.user
*.suo
*.userprefs
*.sln.docstates

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# Logs & temp
*.log
*.tmp
_ReSharper*/

# ไฟล์รูปที่ Messenger อัปโหลด (เก็บบน filesystem ไม่เข้า git)
/uploads/
/App_Data/uploads/

# ค่า config เฉพาะเครื่อง (connection string ฯลฯ)
*.config.local
appsettings.local.json

# ข้อมูลที่ระบบสร้างตอน dev — ต้องไม่เข้า repo
# (D25 รูปอัปโหลด · D28 ไฟล์ .eml ที่เขียนแทนการส่งเมลจริง)
# production ให้ตั้ง PhotoStorageRoot / EmailPickupDirectory ชี้นอกโฟลเดอร์เว็บ
# หมายเหตุ : App_Data/EmailTemplates ยังต้องเข้า repo เพราะเป็น template ตั้งต้น
src/Web/App_Data/Photos/
src/Web/App_Data/Mail/

# applicationhost.config ที่ tools\Start-ForMobile.ps1 generate ให้ตอนรัน
# มี path เต็มของเครื่องอยู่ข้างใน จึงเป็นของเฉพาะเครื่อง ไม่ใช่ของ repo
tools/.iisexpress/
