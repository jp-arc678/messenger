<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Messenger.Infrastructure</RootNamespace>
    <AssemblyName>Messenger.Infrastructure</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- ไฟล์ซอร์สมีข้อความภาษาไทย บังคับให้ compiler อ่านเป็น UTF-8 -->
    <CodePage>65001</CodePage>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Messenger.Domain.csproj" />
    <ProjectReference Include="..\Application\Messenger.Application.csproj" />
  </ItemGroup>

</Project>
