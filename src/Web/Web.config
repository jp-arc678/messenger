<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <connectionStrings>
    <!--
      Dev : SQL Server บนเครื่องตัวเอง ใช้ Windows Authentication
      ตอนขึ้น production ให้เปลี่ยนเป็น SQL login ที่มีสิทธิ์ execute
      stored procedure เท่านั้น
    -->
    <add name="MessengerDb"
         connectionString="Server=localhost;Database=MessengerDb;Integrated Security=SSPI;MultipleActiveResultSets=False;Connect Timeout=30;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />

    <!--
      D25 — โฟลเดอร์เก็บไฟล์รูป (BR-3 : เก็บบน filesystem ไม่เก็บ binary ใน DB)

      ตอนขึ้น production ให้ชี้ไป path นอกโฟลเดอร์เว็บ เช่น D:\MessengerPhotos
      เพื่อไม่ให้ deploy ทับแล้วรูปหาย และไม่ให้เปิดไฟล์ตรงผ่าน URL ได้
      ค่าว่าง = ใช้ ~\App_Data\Photos ของเว็บ (พอสำหรับเครื่อง dev)

      ไม่ว่าจะตั้งเป็น path ไหน การเข้าถึงรูปก็ยังต้องผ่าน /Photos/Show
      ที่ตรวจสาขาและสิทธิ์ก่อนเสมอ (BR-6)
    -->
    <add key="PhotoStorageRoot" value="" />

    <!--
      BR-5 / D28 — อีเมลแจ้งผู้แจ้งเมื่อปิดงาน

      EmailPickupDirectory มีค่า = ไม่ส่งจริง แต่เขียนไฟล์ .eml ลงโฟลเดอร์นั้นแทน
      (ค่าว่างเปล่าใน value = ใช้ ~\App_Data\Mail ของเว็บ) เปิดไฟล์ด้วยโปรแกรมอ่านเมล
      เพื่อตรวจเนื้อความได้โดยไม่ต้องมี SMTP — เหมาะกับเครื่อง dev

      ตอนได้ SMTP จริงของบริษัทแล้ว (D5) :
      1. ลบ key EmailPickupDirectory ทิ้ง หรือใส่ค่า "none"
      2. ตั้ง host/port ที่ <system.net><mailSettings> ท้ายไฟล์นี้
      ไม่ต้องแก้โค้ดเลยแม้แต่บรรทัดเดียว

      EmailTemplateFolder = ที่เก็บ template (.html) ถ้าไม่มีไฟล์จะใช้ template ในโค้ด
    -->
    <add key="EmailFrom" value="messenger-noreply@example.co.th" />
    <add key="EmailFromName" value="ระบบแจ้งงานรับ-ส่งเอกสาร" />
    <add key="EmailPickupDirectory" value="" />
    <add key="EmailTemplateFolder" value="~/App_Data/EmailTemplates" />

    <!--
      ClockOffsetMinutes — เลื่อนนาฬิกาของ "ระบบ" กี่นาที (ค่าว่าง/0 = ใช้เวลาจริง)

      มีไว้ทดสอบเส้นแบ่ง 10:00 ของ BR-1 (UAT ข้อ 2.4) ได้ทุกเวลาโดยไม่ต้องรอเช้า
      และไม่ต้องไปแก้นาฬิกาของ Windows — ตัวอย่าง ถ้าตอนนี้ 22:30 :
        -780  → ระบบมองว่าเป็น 09:30 (ก่อน 10:00) → sendDate ควรเป็น "วันนี้"
        -690  → ระบบมองว่าเป็น 11:00 (หลัง 10:00) → sendDate ควรเป็น "วันทำการถัดไป"

      ค่านี้ถูกเมินทั้งหมดเมื่อ <compilation debug="false"/> (คือตอนขึ้น production)
      จึงไม่มีทางเลื่อนเวลาของระบบจริงได้แม้จะลืมลบค่าทิ้งไว้
      ⚠ อย่าลืมตั้งกลับเป็นค่าว่างหลังทดสอบเสร็จ
    -->
    <add key="ClockOffsetMinutes" value="" />
  </appSettings>

  <system.web>
    <!--
      ต้องประกาศ netstandard ไว้ที่นี่ เพราะ ClosedXML (Phase 5) เป็นไลบรารีแบบ
      netstandard2.0 เมื่อมันอยู่ในโฟลเดอร์ bin ตัว compiler ที่คอมไพล์ไฟล์ .cshtml
      ตอน runtime จะอ่าน metadata ของมันด้วย แล้วฟ้องว่าหา netstandard ไม่เจอ
      (อาการ: ทุกหน้าเว็บขึ้น "CS0012: The type 'System.Object' is defined in an
      assembly that is not referenced")
    -->
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
      </assemblies>
    </compilation>
    <!--
      maxRequestLength หน่วยเป็น KB — ตั้งไว้ 8 MB เผื่อกรณีที่เบราว์เซอร์เก่า
      ย่อรูปฝั่ง client ไม่ได้แล้วส่งไฟล์เต็ม ๆ ขึ้นมา เพื่อให้ PhotoService
      ได้ตอบกลับเป็นข้อความว่า "ไฟล์ใหญ่เกิน 2 MB" แทนที่จะเป็นหน้า error ของ IIS
    -->
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" maxRequestLength="8192" />

    <!--
      ข้อมูลทั้งระบบเป็นภาษาไทย บังคับ UTF-8 ทั้งขาเข้า-ขาออก

      culture ตั้งเป็น en-US โดยตั้งใจ ไม่ใช่ th-TH :
      culture th-TH ใช้ปฏิทินพุทธศักราช ทำให้ทั้งการแสดงผลและการแปลงข้อความ
      เป็นวันที่คลาดไป 543 ปี (เช่น "2026-08-11" จะถูกอ่านเป็น พ.ศ. 2026)
      ระบบจึงแสดงวันที่เป็น ค.ศ. ให้ตรงกับตัวเลือกวันที่บนฟอร์มและกับ
      {YYMM} ในเลขใบงานตาม BR-8
      ส่วน uiCulture ยังเป็น th-TH สำหรับข้อความ resource ภาษาไทย
    -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="en-US" uiCulture="th-TH" />

    <!--
      BR-7 — ระบบไม่เก็บ password เอง ตัวตนมาจาก SSO
      เฟส 0 ใช้ Forms Authentication ห่อผลลัพธ์จาก SSO stub ไว้ใน cookie
      เมื่อเชื่อม SSO จริงแล้ว ให้เปลี่ยนเฉพาะวิธีได้มาซึ่งตัวตน
    -->
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login"
             defaultUrl="~/Home/Index"
             name=".MessengerAuth"
             timeout="480"
             slidingExpiration="true"
             cookieless="UseCookies"
             protection="All"
             requireSSL="false" />
    </authentication>

    <!--
      ต้องเปิด session ไว้ เพราะ TempData ของ MVC 5 ใช้ session เป็นที่เก็บ
      (ใช้ส่งข้อความ "บันทึกเรียบร้อย" ข้าม redirect ตามแบบ Post-Redirect-Get)

      InProc = เก็บในหน่วยความจำของ process เดียวกัน เหมาะกับระบบภายในที่รัน
      IIS เครื่องเดียว ถ้าภายหลังต้องขึ้นหลายเครื่อง (web farm) ต้องเปลี่ยนไปใช้
      StateServer หรือ SQLServer แทน
    -->
    <sessionState mode="InProc" timeout="60" cookieless="UseCookies" />

    <!--
      RemoteOnly = คนที่เปิดจากเครื่อง server เห็น stack trace เต็ม (สะดวกตอน dev)
      ส่วนผู้ใช้ทั่วไปเห็นแค่หน้าสุภาพ ไม่หลุดรายละเอียดภายในระบบ
      ตอนขึ้น production ควรเปลี่ยนเป็น mode="On"
    -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Home/Error">
      <error statusCode="404" redirect="~/Home/NotFound" />
      <error statusCode="403" redirect="~/Home/NotFound" />
    </customErrors>

    <!-- cookie ทั้งหมดห้ามอ่านจาก JavaScript · production ที่มี HTTPS ให้ตั้ง requireSSL="true" -->
    <httpCookies httpOnlyCookies="true" requireSSL="false" />
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <!-- ไม่ส่ง URL ภายใน (ซึ่งมีเลขใบงาน) ออกไปกับ referrer ของลิงก์ภายนอก -->
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages.Razor" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Razor" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <!--
        ClosedXML (export Excel — Phase 5) ลากไลบรารีระบบรุ่นใหม่กว่าที่ .NET Framework
        มีให้เข้ามาด้วย ถ้าไม่ใส่ redirect เหล่านี้ จะได้ FileLoadException ตอนกดดาวน์โหลดไฟล์
      -->
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.1.4.0" newVersion="4.1.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.6.0" newVersion="4.0.6.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.1.1" newVersion="4.0.1.1" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

  <!--
    ค่าปลายทางของ SMTP จริง (BR-5 · D5 ยังรอ contract ของบริษัท)

    ตอนนี้ระบบใช้ EmailPickupDirectory ใน appSettings เขียนไฟล์ .eml แทนการส่งจริง
    ค่าในบล็อกนี้จึงยังไม่ถูกใช้ — เมื่อได้ SMTP จริงแล้วให้ล้างค่า
    EmailPickupDirectory แล้วแก้ host/port ที่นี่
  -->
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network" from="messenger-noreply@example.co.th">
        <network host="smtp.example.co.th" port="25" enableSsl="false" defaultCredentials="true" />
      </smtp>
    </mailSettings>
  </system.net>

</configuration>
