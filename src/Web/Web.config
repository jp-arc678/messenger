<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <connectionStrings>
    <!--
      Dev : SQL Server บนเครื่องตัวเอง ใช้ Windows Authentication
      ตอนขึ้น production ให้เปลี่ยนเป็น SQL login ที่มีสิทธิ์ execute
      stored procedure เท่านั้น
    -->
    <add name="MessengerDb"
         connectionString="Server=localhost;Database=MessengerDb;Integrated Security=SSPI;MultipleActiveResultSets=False;Connect Timeout=30;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" />

    <!--
      ข้อมูลทั้งระบบเป็นภาษาไทย บังคับ UTF-8 ทั้งขาเข้า-ขาออก

      culture ตั้งเป็น en-US โดยตั้งใจ ไม่ใช่ th-TH :
      culture th-TH ใช้ปฏิทินพุทธศักราช ทำให้ทั้งการแสดงผลและการแปลงข้อความ
      เป็นวันที่คลาดไป 543 ปี (เช่น "2026-08-11" จะถูกอ่านเป็น พ.ศ. 2026)
      ระบบจึงแสดงวันที่เป็น ค.ศ. ให้ตรงกับตัวเลือกวันที่บนฟอร์มและกับ
      {YYMM} ในเลขใบงานตาม BR-8
      ส่วน uiCulture ยังเป็น th-TH สำหรับข้อความ resource ภาษาไทย
    -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="en-US" uiCulture="th-TH" />

    <!--
      BR-7 — ระบบไม่เก็บ password เอง ตัวตนมาจาก SSO
      เฟส 0 ใช้ Forms Authentication ห่อผลลัพธ์จาก SSO stub ไว้ใน cookie
      เมื่อเชื่อม SSO จริงแล้ว ให้เปลี่ยนเฉพาะวิธีได้มาซึ่งตัวตน
    -->
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login"
             defaultUrl="~/Home/Index"
             name=".MessengerAuth"
             timeout="480"
             slidingExpiration="true"
             cookieless="UseCookies"
             protection="All"
             requireSSL="false" />
    </authentication>

    <!--
      ต้องเปิด session ไว้ เพราะ TempData ของ MVC 5 ใช้ session เป็นที่เก็บ
      (ใช้ส่งข้อความ "บันทึกเรียบร้อย" ข้าม redirect ตามแบบ Post-Redirect-Get)

      InProc = เก็บในหน่วยความจำของ process เดียวกัน เหมาะกับระบบภายในที่รัน
      IIS เครื่องเดียว ถ้าภายหลังต้องขึ้นหลายเครื่อง (web farm) ต้องเปลี่ยนไปใช้
      StateServer หรือ SQLServer แทน
    -->
    <sessionState mode="InProc" timeout="60" cookieless="UseCookies" />

    <customErrors mode="RemoteOnly" defaultRedirect="~/Error" />
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages.Razor" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Razor" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

</configuration>
