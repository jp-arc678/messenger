@model UserContext
@{
    ViewBag.Title = "หน้าแรก";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">

        <h1 class="h4 mb-3">เข้าสู่ระบบสำเร็จ</h1>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">
                ตัวตนที่ระบบ resolve ได้
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 col-lg-3">รหัสพนักงาน</dt>
                    <dd class="col-sm-8 col-lg-9"><code>@Model.EmpCode</code></dd>

                    <dt class="col-sm-4 col-lg-3">ชื่อ-สกุล</dt>
                    <dd class="col-sm-8 col-lg-9">@Model.FullName</dd>

                    <dt class="col-sm-4 col-lg-3">รหัสแผนก</dt>
                    <dd class="col-sm-8 col-lg-9">@Model.DeptCode</dd>

                    <dt class="col-sm-4 col-lg-3">ชื่อหน่วยงาน</dt>
                    <dd class="col-sm-8 col-lg-9">@Model.UnitName</dd>

                    <dt class="col-sm-4 col-lg-3">เบอร์ภายใน</dt>
                    <dd class="col-sm-8 col-lg-9">@Model.PhoneExt</dd>

                    <dt class="col-sm-4 col-lg-3">อีเมล</dt>
                    <dd class="col-sm-8 col-lg-9">@Model.Email</dd>

                    <dt class="col-sm-4 col-lg-3">สาขา</dt>
                    <dd class="col-sm-8 col-lg-9">
                        <span class="badge text-bg-primary">@Model.BranchCode</span>
                        <span class="ms-1">@Model.BranchName</span>
                    </dd>

                    <dt class="col-sm-4 col-lg-3">สิทธิ์</dt>
                    <dd class="col-sm-8 col-lg-9">
                        <span class="badge text-bg-warning">@Model.RoleDisplayName</span>
                    </dd>
                </dl>
            </div>
        </div>

        <div class="alert alert-secondary mb-0" role="alert">
            <h2 class="h6">สถานะโปรเจกต์</h2>
            <p class="mb-1 small">
                ขณะนี้อยู่ที่ <strong>Phase 0 — Foundation</strong> จึงยังไม่มีเมนูใบแจ้งงาน
                หน้านี้มีไว้ยืนยันว่าโครงระบบ, การ login ผ่าน SSO จำลอง,
                การ resolve สิทธิ์ และการระบุสาขา ทำงานได้ถูกต้อง
            </p>
            <p class="mb-0 small">
                ฟอร์มแจ้งงานจะเริ่มทำใน Phase 1
            </p>
        </div>

    </div>
</div>
