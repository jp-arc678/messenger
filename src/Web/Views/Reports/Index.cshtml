@model ReportViewModel
@{
    ViewBag.Title = "รายงานสรุปงาน";
    var report = Model.Report;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">รายงานสรุปงาน</h1>
        @if (report != null)
        {
            <div class="text-body-secondary small">
                สาขา @report.BranchCode — @report.BranchName ·
                วันที่ส่ง @report.DateFrom.ToString("dd/MM/yyyy")
                @if (report.DateFrom != report.DateTo)
                {
                    <text>ถึง @report.DateTo.ToString("dd/MM/yyyy")</text>
                }
                · @(report.WholeBranch ? "ทั้งสาขา" : "เฉพาะใบที่คุณเป็นผู้แจ้ง")
            </div>
        }
    </div>
    @if (report != null && report.TotalCount > 0)
    {
        <a class="btn btn-success"
           href="@Url.Action("Export", new { dateFrom = Model.DateFrom, dateTo = Model.DateTo })">
            ดาวน์โหลด Excel
        </a>
    }
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<form method="get" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-6 col-lg-3">
            <label class="form-label" for="dateFrom">วันที่ส่ง ตั้งแต่</label>
            <input type="date" class="form-control" id="dateFrom" name="dateFrom" value="@Model.DateFrom" />
        </div>
        <div class="col-6 col-lg-3">
            <label class="form-label" for="dateTo">ถึง</label>
            <input type="date" class="form-control" id="dateTo" name="dateTo" value="@Model.DateTo" />
        </div>
        <div class="col-12 col-lg-6 d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-outline-primary">ดูรายงาน</button>
            <a class="btn btn-outline-secondary"
               href="@Url.Action("Index", new { dateFrom = Model.TodayText, dateTo = Model.TodayText })">วันนี้</a>
            <a class="btn btn-outline-secondary"
               href="@Url.Action("Index", new { dateFrom = Model.WeekStartText, dateTo = Model.TodayText })">สัปดาห์นี้</a>
            <a class="btn btn-outline-secondary"
               href="@Url.Action("Index", new { dateFrom = Model.MonthStartText, dateTo = Model.TodayText })">เดือนนี้</a>
        </div>
    </div>
</form>

@if (report == null)
{
    <div class="alert alert-secondary mb-0" role="alert">ไม่มีข้อมูลรายงาน</div>
    return;
}

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-2">
        <div class="card h-100 text-center">
            <div class="card-body py-3">
                <div class="text-body-secondary small">ทั้งหมด</div>
                <div class="fs-3 fw-semibold">@report.TotalCount</div>
            </div>
        </div>
    </div>
    @foreach (var status in report.ByStatus)
    {
        <div class="col-6 col-lg-2">
            <div class="card h-100 text-center">
                <div class="card-body py-3">
                    <div class="text-body-secondary small">@status.StatusDisplayName</div>
                    <div class="fs-3 fw-semibold">@status.Count</div>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-3">
    <div class="col-12 col-xl-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">แยกตามเจ้าหน้าที่ Messenger</div>
            @if (report.ByMessenger.Count == 0)
            {
                <div class="card-body text-body-secondary">
                    ยังไม่มีใบงานที่ถูกยืนยันรับงานในช่วงนี้
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0 align-middle">
                        <thead>
                            <tr>
                                <th scope="col">เจ้าหน้าที่</th>
                                <th scope="col" class="text-end">ทั้งหมด</th>
                                <th scope="col" class="text-end">เสร็จแล้ว</th>
                                <th scope="col" class="text-end">กำลังวิ่ง</th>
                                <th scope="col" class="text-end">ยกเลิก</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var messenger in report.ByMessenger)
                            {
                                <tr>
                                    <td>
                                        @messenger.MessengerName
                                        <code class="ms-1 small">@messenger.MessengerEmpCode</code>
                                    </td>
                                    <td class="text-end">@messenger.Total</td>
                                    <td class="text-end">@messenger.Completed</td>
                                    <td class="text-end">@messenger.InProgress</td>
                                    <td class="text-end">@messenger.Cancelled</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-12 col-xl-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">แยกรายวัน (ตามวันที่ส่ง)</span>
                <span class="text-body-secondary small">
                    งานบริษัท @report.CompanyCount · งานฝากส่วนตัว @report.PersonalCount
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th scope="col">วันที่</th>
                            <th scope="col" class="text-end">ทั้งหมด</th>
                            <th scope="col" class="text-end">รับแจ้ง</th>
                            <th scope="col" class="text-end">กำลังส่ง</th>
                            <th scope="col" class="text-end">พักการส่ง</th>
                            <th scope="col" class="text-end">เสร็จแล้ว</th>
                            <th scope="col" class="text-end">ยกเลิก</th>
                            <th scope="col" class="text-end">คิวงาน</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in report.ByDay)
                        {
                            <tr class="@(day.Total == 0 ? "text-body-secondary" : null)">
                                <td>@day.SendDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-end fw-semibold">@day.Total</td>
                                <td class="text-end">@day.Received</td>
                                <td class="text-end">@day.Delivering</td>
                                <td class="text-end">@day.Paused</td>
                                <td class="text-end">@day.Completed</td>
                                <td class="text-end">@day.Cancelled</td>
                                <td class="text-end">
                                    <a class="small"
                                       href="@Url.Action("Index", "Queue", new { date = QueueViewModel.FormatDate(day.SendDate) })">เปิดคิว</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
