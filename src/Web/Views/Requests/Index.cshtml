@model RequestListViewModel
@{
    ViewBag.Title = "ใบแจ้งงาน";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">ใบแจ้งงาน</h1>
        <div class="text-body-secondary small">
            สาขา @Model.BranchCode — @Model.BranchName ·
            @(Model.SeesWholeBranch ? "เห็นใบงานทั้งสาขา" : "เห็นเฉพาะใบที่คุณเป็นผู้แจ้งหรือเป็นคนบันทึก")
        </div>
    </div>
    <a class="btn btn-primary" href="@Url.Action("Create")">+ แจ้งงานใหม่</a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success" role="alert">@Model.Message</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<form method="get" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-6 col-lg-2">
            <label class="form-label" for="sendDateFrom">วันที่ส่ง ตั้งแต่</label>
            <input type="date" class="form-control" id="sendDateFrom" name="sendDateFrom" value="@Model.SendDateFrom" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label" for="sendDateTo">ถึง</label>
            <input type="date" class="form-control" id="sendDateTo" name="sendDateTo" value="@Model.SendDateTo" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label" for="requestDateFrom">วันที่บันทึก ตั้งแต่</label>
            <input type="date" class="form-control" id="requestDateFrom" name="requestDateFrom" value="@Model.RequestDateFrom" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label" for="requestDateTo">ถึง</label>
            <input type="date" class="form-control" id="requestDateTo" name="requestDateTo" value="@Model.RequestDateTo" />
        </div>
        <div class="col-12 col-sm-6 col-lg-2">
            <label class="form-label" for="status">สถานะ</label>
            @Html.DropDownList("status", Model.StatusOptions, new { @class = "form-select", id = "status" })
        </div>
        <div class="col-12 col-sm-6 col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary">ค้นหา</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("Index")">ล้าง</a>
        </div>
    </div>
</form>

@if (Model.Requests.Count == 0)
{
    <div class="alert alert-secondary mb-0" role="alert">
        ยังไม่มีใบแจ้งงานที่ตรงกับเงื่อนไข
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white">
            <thead>
                <tr>
                    <th scope="col">เลขใบงาน</th>
                    <th scope="col">วันที่บันทึก</th>
                    <th scope="col">ผู้แจ้ง</th>
                    <th scope="col">วันที่ส่ง</th>
                    <th scope="col">ประเภทงาน</th>
                    <th scope="col">ผู้ติดต่อ</th>
                    <th scope="col">สถานะ</th>
                    <th scope="col" class="text-end">ดู</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.Requests)
                {
                    <tr>
                        <td>
                            <code>@request.ReqNo</code>
                            @if (request.IsPersonal)
                            {
                                <span class="badge text-bg-light ms-1">ส่วนตัว</span>
                            }
                        </td>
                        <td>@request.RequestDateTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@request.RequesterName</td>
                        <td>
                            @request.SendDate.ToString("dd/MM/yyyy")
                            @if (request.SequenceOrder.HasValue)
                            {
                                <span class="badge text-bg-dark ms-1" title="ลำดับวิ่งงานของวัน">@request.SequenceOrder</span>
                            }
                        </td>
                        <td>
                            @if (request.JobTypes == null || request.JobTypes.Count == 0)
                            {
                                <span class="text-body-secondary">—</span>
                            }
                            else
                            {
                                <ul class="list-unstyled mb-0 small">
                                    @foreach (var jobType in request.JobTypes)
                                    {
                                        <li>@jobType.DisplayText</li>
                                    }
                                </ul>
                            }
                        </td>
                        <td>@request.ContactName</td>
                        <td><span class="badge @StatusBadge.CssClass(request.Status)">@request.StatusDisplayName</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary"
                               href="@Url.Action("Details", new { id = request.ReqId })">รายละเอียด</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
