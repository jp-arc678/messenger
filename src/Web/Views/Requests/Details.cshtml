@model RequestDetailsViewModel
@{
    ViewBag.Title = "รายละเอียดใบแจ้งงาน";
    var request = Model.Request;
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-success" role="alert">@Model.Message</div>
        }

        @if (!string.IsNullOrEmpty(Model.WarningMessage))
        {
            <div class="alert alert-warning" role="alert">@Model.WarningMessage</div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
        }

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <div>
                <h1 class="h4 mb-1">@request.ReqNo</h1>
                <span class="badge text-bg-secondary">@request.StatusDisplayName</span>
                <span class="badge text-bg-primary">สาขา @request.BranchCode</span>
                @if (request.SequenceOrder.HasValue)
                {
                    <span class="badge text-bg-dark">ลำดับที่ @request.SequenceOrder</span>
                }
                @if (request.IsPersonal)
                {
                    <span class="badge text-bg-light">งานฝากส่วนตัว</span>
                }
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" href="@Url.Action("Index")">กลับไปรายการ</a>
                @if (Model.CanEdit)
                {
                    <a class="btn btn-primary" href="@Url.Action("Edit", new { id = request.ReqId })">แก้ไข</a>
                }
            </div>
        </div>

        @if (Model.Actions.Count > 0 || Model.CanConfirmReceipt)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold">ดำเนินการ</div>
                <div class="card-body">
                    @Html.Partial("_StatusActions", new StatusActionsViewModel
                    {
                        ReqId = request.ReqId,
                        Actions = Model.Actions,
                        ReturnTo = "details",
                        CanConfirmReceipt = Model.CanConfirmReceipt
                    })
                </div>
            </div>
        }

        @if (!Model.CanEdit)
        {
            <div class="alert alert-secondary small" role="alert">
                ใบแจ้งงานนี้แก้ไขไม่ได้ — แก้ได้เฉพาะใบที่ตัวเองเป็นผู้แจ้ง และต้องอยู่ในสถานะ
                &quot;รับแจ้ง&quot; เท่านั้น (ผู้ดูแลระบบของสาขาแก้ได้ทุกสถานะ)
            </div>
        }

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold">ประเภทงาน</div>
            <div class="card-body">
                @if (request.JobTypes == null || request.JobTypes.Count == 0)
                {
                    <div class="text-body-secondary">ไม่มีข้อมูล</div>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var jobType in request.JobTypes)
                        {
                            <li class="mb-1">
                                <span class="badge text-bg-info">@jobType.JobTypeDisplayName</span>
                                @if (!string.IsNullOrWhiteSpace(jobType.DetailText))
                                {
                                    <span class="ms-1">@jobType.DetailText</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold">ข้อมูลการส่ง</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 col-lg-3">วันที่ส่ง</dt>
                    <dd class="col-sm-8 col-lg-9">@request.SendDate.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-4 col-lg-3">ผู้ติดต่อ</dt>
                    <dd class="col-sm-8 col-lg-9">@request.ContactName</dd>

                    <dt class="col-sm-4 col-lg-3">เบอร์โทร</dt>
                    <dd class="col-sm-8 col-lg-9">@(string.IsNullOrWhiteSpace(request.Phone) ? "-" : request.Phone)</dd>

                    <dt class="col-sm-4 col-lg-3">ที่อยู่</dt>
                    <dd class="col-sm-8 col-lg-9" style="white-space: pre-line;">@request.Address</dd>

                    <dt class="col-sm-4 col-lg-3">รายละเอียดงาน</dt>
                    <dd class="col-sm-8 col-lg-9" style="white-space: pre-line;">@request.Detail</dd>

                    @if (request.RequiresReceiptConfirmation)
                    {
                        <dt class="col-sm-4 col-lg-3">การรับของ (BR-4)</dt>
                        <dd class="col-sm-8 col-lg-9">
                            @if (request.ReceiptConfirmed)
                            {
                                <span class="badge text-bg-success">ยืนยันรับของแล้ว</span>
                                if (request.ReceiptConfirmedAt.HasValue)
                                {
                                    <span class="text-body-secondary">
                                        · @request.ReceiptConfirmedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                        โดย @request.ReceiptConfirmedBy
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="badge text-bg-warning">ยังไม่ได้ยืนยันรับของ</span>
                            }
                        </dd>
                    }

                    @if (request.Assignment != null)
                    {
                        <dt class="col-sm-4 col-lg-3">ผู้รับงาน</dt>
                        <dd class="col-sm-8 col-lg-9">
                            @request.Assignment.MessengerName
                            <code class="ms-1">@request.Assignment.MessengerEmpCode</code>
                            <span class="text-body-secondary">
                                · ยืนยันเมื่อ @request.Assignment.ConfirmedAt.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </dd>
                    }
                </dl>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold">ข้อมูลผู้แจ้ง</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 col-lg-3">ผู้แจ้ง</dt>
                    <dd class="col-sm-8 col-lg-9">
                        @request.RequesterName <code class="ms-1">@request.RequesterEmpCode</code>
                    </dd>

                    <dt class="col-sm-4 col-lg-3">หน่วยงาน</dt>
                    <dd class="col-sm-8 col-lg-9">@request.RequesterUnitName</dd>

                    <dt class="col-sm-4 col-lg-3">เบอร์ภายใน</dt>
                    <dd class="col-sm-8 col-lg-9">@request.RequesterPhoneExt</dd>

                    <dt class="col-sm-4 col-lg-3">อีเมล</dt>
                    <dd class="col-sm-8 col-lg-9">@request.RequesterEmail</dd>

                    <dt class="col-sm-4 col-lg-3">บันทึกเมื่อ</dt>
                    <dd class="col-sm-8 col-lg-9">
                        @request.RequestDateTime.ToString("dd/MM/yyyy HH:mm")
                        @if (request.CreatedBy != request.RequesterEmpCode)
                        {
                            <span class="text-body-secondary">(บันทึกโดย @request.CreatedBy)</span>
                        }
                    </dd>

                    @if (request.UpdatedAt.HasValue)
                    {
                        <dt class="col-sm-4 col-lg-3">แก้ไขล่าสุด</dt>
                        <dd class="col-sm-8 col-lg-9">
                            @request.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                            <span class="text-body-secondary">โดย @request.UpdatedBy</span>
                        </dd>
                    }
                </dl>
            </div>
        </div>

        @Html.Partial("_Photos", Model)

        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">ประวัติสถานะ</div>
            <div class="card-body">
                @if (Model.History.Count == 0)
                {
                    <div class="text-body-secondary">ไม่มีข้อมูล</div>
                }
                else
                {
                    <ol class="list-unstyled mb-0">
                        @foreach (var entry in Model.History)
                        {
                            @* บนจอแคบให้เวลากับรายละเอียดวางซ้อนกันแทนการดันจนล้นจอ *@
                            <li class="d-flex flex-column flex-sm-row gap-1 gap-sm-2 mb-2">
                                <div class="text-body-secondary small flex-shrink-0" style="min-width: 8.5rem;">
                                    @entry.ChangedAt.ToString("dd/MM/yyyy HH:mm")
                                </div>
                                <div>
                                    <span class="badge text-bg-secondary">@entry.ToStatusDisplayName</span>
                                    <span class="text-body-secondary small ms-1">
                                        โดย @(string.IsNullOrWhiteSpace(entry.ByName) ? entry.ByEmpCode : entry.ByName)
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(entry.Note))
                                    {
                                        <div class="small">@entry.Note</div>
                                    }
                                </div>
                            </li>
                        }
                    </ol>
                }
            </div>
        </div>

    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/photo-upload.js")"></script>
}
