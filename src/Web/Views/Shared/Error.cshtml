@model System.Web.Mvc.HandleErrorInfo
@{
    ViewBag.Title = "เกิดข้อผิดพลาด";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <div class="display-6 mb-3">ระบบทำงานผิดพลาด</div>
                <p class="text-body-secondary">
                    เกิดข้อผิดพลาดระหว่างประมวลผลคำขอของคุณ ข้อมูลที่บันทึกไปแล้วไม่ได้รับผลกระทบ<br />
                    หากพบปัญหาซ้ำ กรุณาแจ้งผู้ดูแลระบบพร้อมบอกว่ากำลังทำอะไรอยู่
                </p>
                <a class="btn btn-primary" href="@Url.Action("Index", "Home")">กลับหน้าแรก</a>
            </div>
        </div>
    </div>
</div>
